import tkinter as tk
import random

GAME_WIDTH = 700
GAME_HEIGHT = 700
SPACE_SIZE = 20
BODY_PARTS = 3
SPEED = 75

SNAKE_COLOR = "#90EE90"
FOOD_COLOR = "#FB3B1E"
BACKGROUND_COLOR = "#000000"
TEXT_COLOR = "#FFFFFF"

class Snake:
    def __init__(self, canvas):
        self.canvas = canvas
        self.body_size = BODY_PARTS
        self.coordinates = []
        self.squares = []
        start_x = (GAME_WIDTH // 2 // SPACE_SIZE) * SPACE_SIZE
        start_y = (GAME_HEIGHT // 2 // SPACE_SIZE) * SPACE_SIZE
        for i in range(BODY_PARTS):
            x = start_x - i * SPACE_SIZE
            y = start_y
            self.coordinates.append([x, y])
        for x, y in self.coordinates:
            square = self.canvas.create_rectangle(
                x,
                y,
                x + SPACE_SIZE,
                y + SPACE_SIZE,
                fill=SNAKE_COLOR,
                outline="",
                tags="snake"
            )
            self.squares.append(square)
class Food:
    def __init__(self, canvas, snake_coordinates):
        self.canvas = canvas
        self.coordinates = self.get_random_position(snake_coordinates)
        self.canvas.create_oval(
            self.coordinates[0],
            self.coordinates[1],
            self.coordinates[0] + SPACE_SIZE,
            self.coordinates[1] + SPACE_SIZE,
            fill=FOOD_COLOR,
            outline="",
            tags="food"
        )
    def get_random_position(self, snake_coordinates):
        available_positions = [
            (x, y)
            for x in range(0, GAME_WIDTH, SPACE_SIZE)
            for y in range(0, GAME_HEIGHT, SPACE_SIZE)
            if [x, y] not in snake_coordinates
        ]
        if not available_positions:
            return None
        return list(random.choice(available_positions))
class SnakeGame:
    def __init__(self, root):
        self.root = root
        self.root.title("SHREK!!!!!")
        self.root.resizable(False, False)
        self.score = 0
        self.direction = "right"
        self.next_direction = "right"
        self.running = False
        self.game_over_screen = False
        self.after_id = None
        self.label = tk.Label(
            self.root,
            text="Score: 0",
            font=("Arial", 24),
            bg="#222222",
            fg=TEXT_COLOR,
            pady=5
        )
        self.label.pack(fill="x")
        self.canvas = tk.Canvas(
            self.root,
            bg=BACKGROUND_COLOR,
            height=GAME_HEIGHT,
            width=GAME_WIDTH,
            highlightthickness=0
        )
        self.canvas.pack()
        self.root.bind("<Left>", lambda event: self.change_direction("left"))
        self.root.bind("<Right>", lambda event: self.change_direction("right"))
        self.root.bind("<Up>", lambda event: self.change_direction("up"))
        self.root.bind("<Down>", lambda event: self.change_direction("down"))
        self.root.bind("<a>", lambda event: self.change_direction("left"))
        self.root.bind("<d>", lambda event: self.change_direction("right"))
        self.root.bind("<w>", lambda event: self.change_direction("up"))
        self.root.bind("<s>", lambda event: self.change_direction("down"))
        self.root.bind("<A>", lambda event: self.change_direction("left"))
        self.root.bind("<D>", lambda event: self.change_direction("right"))
        self.root.bind("<W>", lambda event: self.change_direction("up"))
        self.root.bind("<S>", lambda event: self.change_direction("down"))
        self.root.bind("<r>", lambda event: self.restart())
        self.root.bind("<R>", lambda event: self.restart())
        self.restart()
    def restart(self):
        if self.after_id is not None:
            self.root.after_cancel(self.after_id)
            self.after_id = None
        self.canvas.delete("all")
        self.score = 0
        self.direction = "right"
        self.next_direction = "right"
        self.running = True
        self.game_over_screen = False
        self.label.config(text="Score: 0")
        self.snake = Snake(self.canvas)
        self.food = Food(self.canvas, self.snake.coordinates)
        self.next_turn()
    def change_direction(self, new_direction):
        if not self.running:
            return
        opposite = {
            "left": "right",
            "right": "left",
            "up": "down",
            "down": "up"
        }
        if new_direction != opposite[self.direction]:
            self.next_direction = new_direction
    def next_turn(self):
        if not self.running:
            return
        self.direction = self.next_direction
        x, y = self.snake.coordinates[0]
        if self.direction == "up":
            y -= SPACE_SIZE
        elif self.direction == "down":
            y += SPACE_SIZE
        elif self.direction == "left":
            x -= SPACE_SIZE
        elif self.direction == "right":
            x += SPACE_SIZE
        new_head = [x, y]
        if self.collision_check(new_head):
            self.game_over()
            return
        self.snake.coordinates.insert(0, new_head)
        square = self.canvas.create_rectangle(
            x,
            y,
            x + SPACE_SIZE,
            y + SPACE_SIZE,
            fill=SNAKE_COLOR,
            outline="",
            tags="snake"
        )
        self.snake.squares.insert(0, square)
        if self.food.coordinates == new_head:
            self.score += 1
            self.label.config(text=f"Score: {self.score}")
            self.canvas.delete("food")
            self.food = Food(
                self.canvas,
                self.snake.coordinates
            )
            if self.food.coordinates is None:
                self.win()
                return
        else:
            self.snake.coordinates.pop()
            tail_square = self.snake.squares.pop()
            self.canvas.delete(tail_square)
        if self.self_collision():
            self.game_over()
            return
        self.after_id = self.root.after(SPEED, self.next_turn)
    def collision_check(self, position):
        x, y = position
        if (
            x < 0
            or x >= GAME_WIDTH
            or y < 0
            or y >= GAME_HEIGHT
        ):
            return True
        return False
    def self_collision(self):
        head = self.snake.coordinates[0]
        for body_part in self.snake.coordinates[1:]:
            if head == body_part:
                return True
        return False
    def game_over(self):
        self.running = False
        self.game_over_screen = True
        if self.after_id is not None:
            self.root.after_cancel(self.after_id)
            self.after_id = None
        self.canvas.create_rectangle(
            100,
            240,
            GAME_WIDTH - 100,
            460,
            fill="#111111",
            outline="#FFFFFF"
        )
        self.canvas.create_text(
            GAME_WIDTH // 2,
            300,
            text="GAME OVER",
            font=("Arial", 48, "bold"),
            fill="red"
        )
        self.canvas.create_text(
            GAME_WIDTH // 2,
            365,
            text=f"Score: {self.score}",
            font=("Arial", 28),
            fill=TEXT_COLOR
        )
        self.canvas.create_text(
            GAME_WIDTH // 2,
            420,
            text="Press R to restart",
            font=("Arial", 22),
            fill=TEXT_COLOR
        )
    def win(self):
        self.running = False
        self.game_over_screen = True

        if self.after_id is not None:
            self.root.after_cancel(self.after_id)
            self.after_id = None
        self.canvas.create_rectangle(
            100,
            240,
            GAME_WIDTH - 100,
            460,
            fill="#111111",
            outline="#FFFFFF"
        )
        self.canvas.create_text(
            GAME_WIDTH // 2,
            300,
            text="YOU WIN!",
            font=("Arial", 64, "bold"),
            fill=SNAKE_COLOR
        )
        self.canvas.create_text(
            GAME_WIDTH // 2,
            365,
            text=f"Score: {self.score}",
            font=("Arial", 64),
            fill=TEXT_COLOR
        )
        self.canvas.create_text(
            GAME_WIDTH // 2,
            420,
            text="Press R to play again",
            font=("Arial", 22),
            fill=TEXT_COLOR
        )
if __name__ == "__main__":
    root = tk.Tk()
    root.attributes("-fullscreen", True)
    game = SnakeGame(root)
    root.mainloop()
